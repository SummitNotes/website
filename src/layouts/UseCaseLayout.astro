---
import Layout from "./Layout.astro";
import { Card } from "../components/ui/card";
import { Separator } from "../components/ui/separator";
import Footer from "../components/Footer";
import { ChevronRight, Home } from "lucide-react";

export interface Props {
  title: string;
  description: string;
  /** Short audience name, used in the breadcrumb and eyebrow. */
  audience: string;
  heading: string;
  lead: string;
  /** Slug of this page under /use-cases, to leave it out of "Other use cases". */
  current: "consulting" | "legal" | "finance" | "healthcare";
  ctaHeading: string;
  ctaText: string;
}

const { title, description, audience, heading, lead, current, ctaHeading, ctaText } =
  Astro.props;

const useCases = [
  { slug: "consulting", name: "Independent Consultants", blurb: "Client notes organized by engagement" },
  { slug: "legal", name: "Legal Professionals", blurb: "Meeting notes kept with each matter" },
  { slug: "finance", name: "Finance Professionals", blurb: "Notes by client or household" },
  { slug: "healthcare", name: "Healthcare Teams", blurb: "Notes for team and case review meetings" },
];
const others = useCases.filter((u) => u.slug !== current);
---

<Layout title={title} description={description} breadcrumb={[{ name: `For ${audience}` }]}>
  <div class="min-h-screen bg-gradient-to-br from-background via-background to-muted/20">
    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
          <a href="/" class="hover:text-foreground transition-colors flex items-center gap-1">
            <Home className="w-4 h-4" />
            Home
          </a>
          <ChevronRight className="w-4 h-4" />
          <span class="text-foreground font-medium">For {audience}</span>
        </div>

        <article>
          <Card className="p-8 lg:p-12">
            <header class="mb-8">
              <p class="text-sm font-medium text-purple-600 mb-4">Summit for {audience}</p>
              <h1 class="text-4xl lg:text-5xl font-bold text-foreground mb-6">{heading}</h1>
              <p class="text-xl text-muted-foreground leading-relaxed">{lead}</p>
            </header>

            <Separator className="mb-8" />

            <div class="use-case-prose prose prose-slate max-w-none
              prose-headings:text-foreground prose-headings:font-bold
              prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
              prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-2
              prose-p:text-muted-foreground prose-p:leading-relaxed prose-p:my-4
              prose-a:text-purple-600 prose-a:no-underline hover:prose-a:underline
              prose-strong:text-foreground prose-strong:font-semibold
              prose-ul:text-muted-foreground prose-ul:my-4
              prose-ol:text-muted-foreground prose-ol:my-4
              prose-li:my-2
              [&_h3+p]:mt-1
            ">
              <slot />
            </div>

            <Separator className="my-10" />

            <!-- CTA -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
              <div>
                <h2 class="text-2xl font-bold text-foreground mb-2">{ctaHeading}</h2>
                <p class="text-muted-foreground">{ctaText}</p>
              </div>
              <a
                href="/download?from=use-case-cta"
                data-source="use-case-cta"
                class="download-button inline-flex shrink-0 items-center justify-center px-6 py-3 bg-sky-400 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
              >
                See Mac download options
              </a>
            </div>
          </Card>

          <!-- Other use cases -->
          <div class="mt-8 grid md:grid-cols-3 gap-4">
            {others.map((u) => (
              <a href={`/use-cases/${u.slug}`} class="group">
                <Card className="p-4 hover:shadow-lg transition-shadow h-full">
                  <div class="text-sm text-muted-foreground mb-1">For {u.name}</div>
                  <div class="font-semibold text-foreground group-hover:text-purple-600 transition-colors">
                    {u.blurb}
                  </div>
                </Card>
              </a>
            ))}
          </div>
        </article>
      </div>
    </div>
  </div>
  <Footer client:load />
</Layout>

<style>
  :global(.dark) .use-case-prose {
    --tw-prose-body: var(--muted-foreground);
    --tw-prose-headings: var(--foreground);
    --tw-prose-links: rgb(147 51 234);
    --tw-prose-bold: var(--foreground);
    --tw-prose-counters: var(--muted-foreground);
    --tw-prose-bullets: var(--muted-foreground);
  }
</style>
