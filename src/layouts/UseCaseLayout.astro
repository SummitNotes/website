---
import ArticleLayout from "./ArticleLayout.astro";
import Prose from "../components/article/Prose.astro";
import LinkCard from "../components/article/LinkCard.astro";

export interface Props {
  title: string;
  description: string;
  /** Short audience name, used in the breadcrumb and eyebrow. */
  audience: string;
  heading: string;
  lead: string;
  /** Slug of this page under /use-cases, to leave it out of "Other use cases". */
  current: "consulting" | "legal" | "finance" | "healthcare";
  ctaHeading: string;
  ctaText: string;
}

const { title, description, audience, heading, lead, current, ctaHeading, ctaText } =
  Astro.props;

const useCases = [
  { slug: "consulting", name: "Independent Consultants", blurb: "Client notes organized by engagement" },
  { slug: "legal", name: "Legal Professionals", blurb: "Meeting notes kept with each matter" },
  { slug: "finance", name: "Finance Professionals", blurb: "Notes by client or household" },
  { slug: "healthcare", name: "Healthcare Teams", blurb: "Notes for team and case review meetings" },
];
const others = useCases.filter((u) => u.slug !== current);
---

<ArticleLayout
  title={title}
  description={description}
  breadcrumb={[{ name: `For ${audience}` }]}
  eyebrow={`Summit for ${audience}`}
  heading={heading}
  lead={lead}
  afterCols={3}
>
  <Prose>
    <slot />
  </Prose>

  <div slot="card-end" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
    <div>
      <h2 class="text-2xl font-bold text-foreground mb-2">{ctaHeading}</h2>
      <p class="text-muted-foreground">{ctaText}</p>
    </div>
    <a
      href="/download?from=use-case-cta"
      data-source="use-case-cta"
      class="download-button inline-flex shrink-0 items-center justify-center px-6 py-3 bg-cta text-cta-ink font-semibold rounded-lg hover:bg-cta-hover transition-colors"
    >
      See Mac download options
    </a>
  </div>

  <Fragment slot="after-card">
    {others.map((u) => (
      <LinkCard href={`/use-cases/${u.slug}`} kicker={`For ${u.name}`} title={u.blurb} />
    ))}
  </Fragment>
</ArticleLayout>
