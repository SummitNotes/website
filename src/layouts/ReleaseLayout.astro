---
import ArticleLayout from "./ArticleLayout.astro";
import Prose from "../components/article/Prose.astro";
import LinkCard from "../components/article/LinkCard.astro";
import DocsNav from "../components/article/DocsNav.astro";
import { Calendar } from "lucide-react";
import { techArticleSchema } from "../lib/schema";

interface Props {
  version: string;
  date: string;
  title?: string;
}

const { version, date, title = `Summit AI Notes ${version}` } = Astro.props;

const description = `What's new in Summit AI Notes ${version}`;

const releaseSchema = techArticleSchema({
  path: Astro.url.pathname,
  headline: `${title} — Release Notes`,
  description,
  datePublished: date,
});

const parsed = new Date(date);
const displayDate = Number.isNaN(parsed.getTime())
  ? date
  : parsed.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<ArticleLayout
  title={`${title} - Release Notes`}
  description={description}
  breadcrumb={[
    { name: "Documentation", path: "/docs" },
    { name: "Release Notes", path: "/docs/release-notes" },
    { name: `Version ${version}` },
  ]}
  schema={releaseSchema}
  heading={title}
>
  <DocsNav slot="sidebar" section="release-notes" />

  <div slot="meta" class="flex items-center gap-1 text-sm text-muted-foreground mb-4">
    <Calendar className="w-4 h-4" />
    {displayDate}
  </div>

  <Prose>
    <slot />
  </Prose>

  <LinkCard slot="after-card" href="/docs/release-notes" kicker="Release notes" title="All releases" />
</ArticleLayout>
