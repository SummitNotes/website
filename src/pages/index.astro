---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import HeroSection from "../components/HeroSection";
import TrustStrip from "../components/TrustStrip";
import HowItWorks from "../components/HowItWorks";
import SocialProof from "../components/SocialProof";
import UseCases from "../components/UseCases";
import AIQuality from "../components/AIQuality";
import PricingSection from "../components/PricingSection";
import Footer from "../components/Footer";
import {
  absoluteUrl,
  APP_STORE_URL,
  ORGANIZATION_ID,
  PRODUCT_DESCRIPTION,
  SITE_URL,
  SOFTWARE_ID,
  WEBSITE_ID,
} from "../lib/schema";
import { latestRelease } from "../lib/releases";

const offer = (name: string, price: string) => ({
  "@type": "Offer",
  name,
  price,
  priceCurrency: "USD",
  availability: "https://schema.org/InStock",
  url: `${SITE_URL}/#pricing`,
});

// No aggregateRating: the 4.6 App Store rating is visible on the page, but the
// rating count is not, and Google requires both to match visible content.
const appSchema = {
  "@type": "SoftwareApplication",
  "@id": SOFTWARE_ID,
  name: "Summit AI Notes",
  alternateName: ["SummitAI", "Summit AI", "Summit Notes"],
  url: `${SITE_URL}/`,
  downloadUrl: APP_STORE_URL,
  mainEntityOfPage: { "@id": WEBSITE_ID },
  publisher: { "@id": ORGANIZATION_ID },
  operatingSystem: "macOS 15 or later",
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "AI meeting assistant",
  description: PRODUCT_DESCRIPTION,
  ...(latestRelease ? { softwareVersion: latestRelease.version } : {}),
  image: absoluteUrl("/logo512x512.png"),
  screenshot: [
    absoluteUrl("/screenshot-1.jpg"),
    absoluteUrl("/screenshot-2.jpg"),
    absoluteUrl("/screenshot-3.jpg"),
  ],
  offers: [
    offer("Monthly", "12.99"),
    offer("Yearly", "89.99"),
    offer("Lifetime", "149.99"),
  ],
  featureList: [
    "Records online and in-person meetings without a bot",
    "On-device transcription",
    "On-device AI summaries and action items",
    "Speaker identification",
    "Full-text meeting search",
    "Document chat",
    "Works with Zoom, Teams, Meet, and any app",
    "Support for more than 100 languages",
    "Optional user-configured cloud AI providers",
  ],
};
---

<Layout
  title="Summit AI Notes - Private AI Meeting Notes for Consultants"
  description="Client meeting notes that never leave your Mac. Summit records calls locally, creates searchable transcripts, summaries, and action items, and keeps your calls out of vendor AI training sets."
  schema={appSchema}
>
  <div class="min-h-screen">
    <Navigation />
    <div id="hero">
      <HeroSection client:load />
    </div>
    <TrustStrip client:load />
    <div id="features">
      <SocialProof client:load />
    </div>
    <div id="use-cases">
      <UseCases client:load />
    </div>
    <AIQuality client:load />
    <div id="how-it-works">
      <HowItWorks client:load />
    </div>
    <PricingSection />
    <Footer client:load />
  </div>
</Layout>
