---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer";
import { ArrowRight, Check, Cpu, FileText, Folder, LockKeyhole, Monitor, Server, ShieldCheck } from "lucide-react";
import { downloadPagePath } from "../lib/download";

const contactSubject = "Summit for our team";
const contactBody = "Hi Dmitriy,\r\n\r\nWe are interested in Summit for our team.\r\n\r\nCompany:\r\nNumber of Mac users:\r\nMeeting workflow:\r\nPreferred storage and AI provider:\r\nHelp we need with a pilot:\r\n\r\nThanks!";
const contactHref = `mailto:hello@summitnotes.app?subject=${encodeURIComponent(contactSubject)}&body=${encodeURIComponent(contactBody)}`;

const features = [
  { title: "A consistent meeting format", text: "Create summary templates for client calls, interviews and project reviews. Assign a template to a folder so each kind of meeting captures the decisions and next steps that matter." },
  { title: "Context for each client", text: "Add background information to a project or client folder. Summit uses that context to make the summaries of those meetings more relevant." },
  { title: "Preparation and recurring recaps", text: "Prepare for upcoming meetings and save Live Queries for recurring updates across your own notes. Ask what changed on a project or which client commitments need attention." },
  { title: "Answers you can check", text: "Search and chat across your meeting library, with answers that link back to their sources. Filter by people, tags and dates to find the conversation you need." },
  { title: "Your connected AI assistants", text: "Connect compatible AI tools through MCP to search and read your Summit notes. You approve the connection; the assistant’s own data policy applies to content it receives." },
  { title: "Fits your working day", text: "Record online and in-person conversations without a meeting bot. Use calendar recording rules, import existing audio or video, and send action items to Apple Reminders." },
];

const faqs = [
  { question: "Will everyone see the same library inside Summit?", answer: "Each person has their own library in Summit. Team sharing happens through exported Markdown files in a shared folder. Colleagues read those files using their existing tools; other people’s meetings do not automatically appear inside Summit." },
  { question: "How does sharing through Google Drive work?", answer: "Choose a local folder synced by Google Drive as your Markdown export destination, then select which Summit folders to include. The Drive desktop app syncs those exported files. Your organization manages access in Drive. This is file-based sharing, not a direct Google Drive account integration in Summit." },
  { question: "Can we keep personal 1:1s out of the shared folder?", answer: "Yes. Markdown auto-export can be filtered by folder. Include client or project meeting folders and leave personal 1:1 folders out. These settings control automatic export; they are not centrally enforced access policies. We can help you check the setup during your pilot." },
  { question: "Can we use an AI model on our own infrastructure?", answer: "Yes, through a compatible custom API endpoint. This can be a server on your company network or a model hosted in your corporate cloud. We can help check API compatibility and connectivity during setup. Built-in local models are another option when you want AI processing on the Mac itself." },
  { question: "Do employees need a personal Apple ID to buy Summit?", answer: "The direct-download version uses licenses purchased from us, without an Apple ID attached. You can pay through Stripe or contact us to arrange payment by invoice for your team. App Store purchases and direct licenses are separate." },
  { question: "What does help with a pilot include?", answer: "We work with you on the initial setup: selecting an AI option, connecting a compatible corporate endpoint, configuring shared export, and preparing meeting templates. Contact us with your team size and workflow so we can agree on the pilot scope and commercial terms." },
];
---

<Layout
  title="Summit for Teams — Your Meeting Notes, Your Infrastructure"
  description="Private meeting notes for Mac teams. Share selected meetings as Markdown, use local or corporate AI, buy licenses by invoice, and get hands-on help with your pilot."
  breadcrumb={[{ name: "For Teams" }]}
>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="teams-page">
    <header class="page-header wrap">
      <a href="/" class="brand"><img src="/logo.svg" width="36" height="36" alt="" />Summit AI Notes</a>
      <nav aria-label="Main navigation">
        <a href="/security/architecture">Security</a>
        <a href="#pilot" class="header-cta">Plan a pilot <ArrowRight size={16} aria-hidden="true" /></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">SUMMIT FOR TEAMS</p>
          <h1>Your team’s meetings.<br /><span>Your infrastructure.</span></h1>
          <p class="lead">Capture decisions and next steps on your Mac. Share selected notes in your company’s storage, use the AI you choose, and get personal help bringing your team on board.</p>
          <div class="actions">
            <a href={contactHref} class="button primary">Talk about your team <ArrowRight size={18} aria-hidden="true" /></a>
            <a href={downloadPagePath("teams-hero")} data-source="teams-hero" class="button secondary download-button">Download for Mac</a>
          </div>
          <p class="small">Apple Silicon Mac · Try 15 recordings free, no signup</p>
        </div>
        <aside class="hero-note" aria-label="Your team setup">
          <p class="eyebrow">A SETUP THAT FITS YOUR COMPANY</p>
          <div><Monitor size={24} aria-hidden="true" /><p><strong>A private workspace on each Mac</strong><span>Recordings, transcripts and meeting notes</span></p></div>
          <div><Folder size={24} aria-hidden="true" /><p><strong>Selected notes in your shared folder</strong><span>Markdown files your colleagues can use</span></p></div>
          <div><Cpu size={24} aria-hidden="true" /><p><strong>Your choice of AI</strong><span>On-device, on-premises or corporate cloud</span></p></div>
          <div class="note-footer"><Check size={18} aria-hidden="true" /> Direct licenses · Stripe or invoice</div>
        </aside>
      </section>

      <section class="sharing section" id="sharing">
        <div class="wrap">
          <div class="section-heading">
            <p class="eyebrow">SHARE WITH INTENTION</p>
            <h2>Client calls go to the team.<br />Personal 1:1s stay out.</h2>
            <p>Choose which folders auto-export to Markdown. Point the export at a shared folder synced by Google Drive, and your team can read the results in the tools they already use.</p>
          </div>
          <figure class="export-example">
            <figcaption>Example setup · Markdown auto-export</figcaption>
            <div class="export-flow">
              <div class="source-folders">
                <p class="diagram-label">YOUR FOLDERS IN SUMMIT</p>
                <div class="folder-row"><Folder size={20} aria-hidden="true" /><span>Client calls</span><span class="export-status">Export on</span></div>
                <div class="folder-row"><Folder size={20} aria-hidden="true" /><span>Project meetings</span><span class="export-status">Export on</span></div>
                <div class="folder-row private"><LockKeyhole size={20} aria-hidden="true" /><span>Personal 1:1s</span><span class="private-status">Export off</span></div>
              </div>
              <div class="flow-arrow"><ArrowRight size={28} aria-hidden="true" /><span>Selected<br />folders only</span></div>
              <div class="shared-folder">
                <p class="diagram-label">YOUR COMPANY’S SHARED FOLDER</p>
                <h3><Folder size={22} aria-hidden="true" /> Team meeting notes</h3>
                <p><FileText size={18} aria-hidden="true" /> Client kickoff.md</p>
                <p><FileText size={18} aria-hidden="true" /> Project review.md</p>
                <span class="storage-caption">Synced by your storage app.<br />Access managed by your company.</span>
              </div>
            </div>
          </figure>
          <p class="sharing-note">Each person keeps their own library inside Summit. Colleagues access shared Markdown files; their meetings do not appear in your app. Export filters control what is automatically shared.</p>
        </div>
      </section>

      <section class="section wrap" id="ai">
        <div class="section-heading">
          <p class="eyebrow">BRING YOUR AI</p>
          <h2>Use the models your company chooses.</h2>
          <p>Keep transcription on the Mac and choose where AI summaries and chat run. We can help you connect and test the setup that works for your team.</p>
        </div>
        <div class="ai-grid">
          <article><Cpu size={28} aria-hidden="true" /><h3>On your Mac</h3><p>Download a built-in local model and process your meetings on-device. Once the models are installed, transcription and local AI can work offline.</p><a href="/docs/setup/local-ai">Explore local AI <ArrowRight size={16} aria-hidden="true" /></a></article>
          <article><Server size={28} aria-hidden="true" /><h3>On your own servers</h3><p>Connect to a compatible model running on your company network. Use your infrastructure for AI processing, including an on-premises deployment.</p><a href="/docs/settings/llm">See AI configuration <ArrowRight size={16} aria-hidden="true" /></a></article>
          <article><ShieldCheck size={28} aria-hidden="true" /><h3>In your corporate cloud</h3><p>Point Summit at an approved, compatible AI endpoint. The text needed for summaries and chat is sent there and follows that provider’s data policies.</p><a href={contactHref}>Discuss compatibility <ArrowRight size={16} aria-hidden="true" /></a></article>
        </div>
        <p class="small ai-footnote">Custom servers require a compatible API, such as an OpenAI-compatible endpoint. We’ll check the connection during your pilot.</p>
      </section>

      <section class="security-band">
        <div class="wrap security-layout">
          <div><p class="eyebrow">READY FOR THE IT CONVERSATION</p><h2>Know where your meeting data goes.</h2></div>
          <div><p>Recording and transcription run locally. With local AI selected, summaries and chat run on your Mac too. Remote AI, shared exports, connected assistants and optional sync introduce the data flows you choose to enable.</p><p>The Summit app does not send usage analytics. The direct-download app contacts our license server for activation and periodic license checks, and checks for updates.</p><a href="/security/architecture">Read the data-flow and security architecture <ArrowRight size={18} aria-hidden="true" /></a></div>
        </div>
      </section>

      <section class="section wrap">
        <div class="section-heading"><p class="eyebrow">FROM CONVERSATION TO FOLLOW-THROUGH</p><h2>Useful before, during and after the call.</h2></div>
        <div class="feature-grid">{features.map((feature, index) => <article><span class="feature-number">0{index + 1}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
      </section>

      <section class="buying section">
        <div class="wrap buying-layout">
          <div><p class="eyebrow">BUILT FOR A COMPANY PURCHASE</p><h2>Get your team set up.<br />Leave Apple IDs out of purchasing.</h2><p>Download Summit directly and buy the licenses your team needs from us. Pay through Stripe, or arrange payment by invoice.</p><a href={contactHref} class="text-link">Discuss team licenses <ArrowRight size={18} aria-hidden="true" /></a></div>
          <ul class="purchase-points">
            <li><Check size={20} aria-hidden="true" /><div><strong>Direct installation</strong><span>A Mac download signed and notarized by Apple.</span></div></li>
            <li><Check size={20} aria-hidden="true" /><div><strong>Company purchasing</strong><span>Licenses without a personal Apple ID attached.</span></div></li>
            <li><Check size={20} aria-hidden="true" /><div><strong>In-app updates</strong><span>Updates arrive directly in the downloaded app.</span></div></li>
            <li><Check size={20} aria-hidden="true" /><div><strong>A person to help you start</strong><span>Work directly with us on your team’s setup.</span></div></li>
          </ul>
        </div>
      </section>

      <section class="section wrap" id="pilot">
        <div class="pilot-panel">
          <div><p class="eyebrow">HANDS-ON HELP FROM THE START</p><h2>Let’s get your first team running.</h2><p>Tell us how your team works. We’ll help you plan a pilot, configure exports, connect a compatible corporate AI endpoint, and prepare templates for your meetings.</p><a href={contactHref} class="button primary">Plan a pilot with us <ArrowRight size={18} aria-hidden="true" /></a><p class="small">We’ll agree on the scope and commercial terms together.</p></div>
          <ol class="pilot-steps">
            <li><span>01</span><div><h3>Map your workflow</h3><p>Team size, meeting types, storage and AI requirements.</p></div></li>
            <li><span>02</span><div><h3>Configure it together</h3><p>Licenses, models, selected exports and meeting templates.</p></div></li>
            <li><span>03</span><div><h3>Try real meetings</h3><p>Review the results with a small group and plan the next step.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="faq wrap">
        <h2>A few practical questions</h2>
        {faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
      </section>
    </main>
  </div>
  <Footer />
</Layout>

<style>
  .teams-page { color: #0b1220; background: #fff; }
  .wrap { max-width: 1200px; margin-inline: auto; padding-inline: 28px; }
  .page-header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 26px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 650; font-size: 18px; }
  .brand img { border-radius: 9px; }
  nav { display: flex; gap: 28px; align-items: center; font-size: 14px; font-weight: 550; }
  .header-cta { display: inline-flex; align-items: center; gap: 8px; }
  a { text-underline-offset: 4px; }
  a:hover { text-decoration: underline; }
  a:focus-visible, summary:focus-visible { outline: 3px solid #0284c7; outline-offset: 5px; }
  .skip-link { position: fixed; top: -100px; left: 20px; padding: 12px 20px; background: #fff; z-index: 100; }
  .skip-link:focus { top: 12px; }
  .hero { padding-top: 76px; padding-bottom: 96px; display: grid; grid-template-columns: 1.35fr 1fr; gap: 52px; align-items: center; }
  .eyebrow { color: #0369a1; font-size: 12px; font-weight: 700; letter-spacing: .13em; margin-bottom: 20px; }
  h1 { font-size: clamp(38px, 4.4vw, 58px); line-height: 1.1; font-weight: 650; letter-spacing: -.045em; }
  h1 span { color: #0ea5e9; }
  .lead { margin-block: 26px; font-size: 19px; line-height: 1.65; color: #475569; max-width: 580px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
  .button { display: inline-flex; justify-content: center; align-items: center; gap: 10px; padding: 14px 18px; border-radius: 10px; font-size: 15px; font-weight: 600; }
  .button:hover { text-decoration: none; }
  .primary { background: #0b1220; color: white; }
  .primary:hover { background: #1e3a5f; }
  .secondary { background: white; border: 1px solid #cbd5e1; }
  .secondary:hover { background: #f0f9ff; }
  .small { font-size: 13px; line-height: 1.6; color: #526277; }
  .hero-note { background: #0b1729; color: #fff; border-radius: 22px; padding: 32px; box-shadow: 0 24px 60px -30px #0b172960; }
  .hero-note .eyebrow { color: #7dd3fc; font-size: 11px; }
  .hero-note > div { display: flex; gap: 16px; padding-block: 23px; border-bottom: 1px solid #ffffff20; }
  .hero-note :global(svg) { flex-shrink: 0; color: #7dd3fc; }
  .hero-note strong, .hero-note span { display: block; }
  .hero-note strong { font-size: 16px; font-weight: 550; }
  .hero-note span { font-size: 14px; color: #b9cadf; line-height: 1.6; margin-top: 6px; }
  .hero-note .note-footer { border: 0; padding-bottom: 0; font-size: 14px; align-items: center; }
  .section { padding-block: 88px; }
  h2 { font-size: clamp(30px, 3.3vw, 42px); line-height: 1.15; font-weight: 600; letter-spacing: -.035em; }
  h3 { font-size: 19px; font-weight: 600; line-height: 1.4; }
  .section-heading { max-width: 730px; margin-bottom: 40px; }
  .section-heading > p:last-child:not(.eyebrow), .buying-layout > div > p:not(.eyebrow), .pilot-panel > div > p:not(.eyebrow):not(.small) { font-size: 17px; color: #475569; line-height: 1.7; margin-top: 22px; }
  .sharing { background: #f1f7fb; border-block: 1px solid #dfebf3; }
  .export-example { background: #fff; border: 1px solid #d6e2ec; border-radius: 16px; overflow: hidden; }
  figcaption { padding: 17px 28px; border-bottom: 1px solid #e2e8f0; font-size: 14px; color: #526277; }
  .export-flow { display: grid; grid-template-columns: 1fr 110px 1fr; gap: 16px; padding: 32px; align-items: center; }
  .diagram-label { font-size: 11px; letter-spacing: .08em; color: #526277; font-weight: 650; margin-bottom: 18px; }
  .folder-row { display: flex; align-items: center; gap: 12px; padding: 17px 14px; margin-top: 10px; border: 1px solid #dbe6ee; border-radius: 8px; font-size: 15px; }
  .folder-row :global(svg) { color: #0369a1; flex-shrink: 0; }
  .export-status, .private-status { margin-left: auto; font-size: 12px; white-space: nowrap; }
  .export-status { color: #047857; }
  .private-status { color: #64748b; }
  .private { background: #f8fafc; }
  .flow-arrow { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; color: #526277; font-size: 12px; line-height: 1.5; }
  .shared-folder { padding: 24px; background: #eef8ff; border: 1px solid #b8def5; border-radius: 10px; }
  .shared-folder h3, .shared-folder > p:not(.diagram-label) { display: flex; align-items: center; gap: 10px; }
  .shared-folder h3 { font-size: 17px; margin-bottom: 22px; }
  .shared-folder > p:not(.diagram-label) { font-size: 14px; margin-bottom: 12px; color: #334155; }
  .storage-caption { display: block; margin-top: 24px; font-size: 13px; line-height: 1.6; color: #526277; }
  .sharing-note { font-size: 14px; line-height: 1.7; color: #526277; max-width: 830px; margin-top: 22px; }
  .ai-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .ai-grid article { border-top: 2px solid #7dd3fc; padding-top: 26px; display: flex; flex-direction: column; align-items: flex-start; }
  .ai-grid :global(svg) { color: #0369a1; }
  .ai-grid h3 { margin-block: 18px 12px; }
  .ai-grid p, .feature-grid p { font-size: 16px; line-height: 1.75; color: #475569; }
  .ai-grid a { display: flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 22px; color: #0369a1; font-size: 14px; font-weight: 600; }
  .ai-footnote { margin-top: 30px; }
  .security-band { background: #0b1729; color: #fff; padding-block: 60px; }
  .security-layout { display: grid; grid-template-columns: 1fr 1.15fr; gap: 70px; }
  .security-band .eyebrow { color: #7dd3fc; }
  .security-band p:not(.eyebrow) { color: #c4d2e3; font-size: 16px; line-height: 1.8; margin-bottom: 18px; }
  .security-band a { color: #7dd3fc; display: inline-flex; align-items: center; gap: 10px; font-size: 15px; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 36px; }
  .feature-number { color: #0369a1; font-size: 13px; font-weight: 600; }
  .feature-grid h3 { margin-block: 12px; }
  .buying { background: #f8fafc; border-block: 1px solid #e2e8f0; }
  .buying-layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 90px; align-items: center; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 24px; color: #0369a1; font-weight: 600; }
  .purchase-points { display: grid; gap: 26px; }
  .purchase-points li { display: flex; align-items: flex-start; gap: 15px; }
  .purchase-points :global(svg) { color: #047857; flex-shrink: 0; margin-top: 3px; }
  .purchase-points strong, .purchase-points span { display: block; }
  .purchase-points strong { font-size: 16px; font-weight: 600; }
  .purchase-points span { color: #475569; margin-top: 5px; font-size: 15px; line-height: 1.6; }
  .pilot-panel { background: #edf7fe; border: 1px solid #c8e5f7; padding: 48px; border-radius: 20px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px; align-items: center; }
  .pilot-panel .button { margin-block: 26px 12px; }
  .pilot-steps { display: grid; gap: 30px; }
  .pilot-steps li { display: flex; gap: 18px; }
  .pilot-steps li > span { color: #0369a1; font-size: 14px; padding-top: 4px; }
  .pilot-steps h3 { font-size: 17px; }
  .pilot-steps p { font-size: 15px; color: #475569; line-height: 1.7; margin-top: 6px; }
  .faq { max-width: 880px; padding-bottom: 100px; }
  .faq h2 { margin-bottom: 30px; }
  details { border-bottom: 1px solid #dbe3eb; }
  summary { cursor: pointer; padding-block: 22px; display: flex; justify-content: space-between; align-items: center; gap: 24px; font-size: 17px; font-weight: 550; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: #0369a1; font-size: 22px; }
  details[open] summary span { transform: rotate(45deg); }
  details p { color: #475569; font-size: 16px; line-height: 1.8; padding-bottom: 24px; }
  @media (max-width: 960px) {
    .hero { gap: 30px; grid-template-columns: 1.1fr 1fr; padding-top: 45px; }
    .hero-note { padding: 24px; }
    .export-flow { grid-template-columns: 1fr 60px 1fr; padding: 24px; }
    .folder-row { flex-wrap: wrap; }
    .shared-folder { padding: 18px; }
    .ai-grid { gap: 22px; }
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .buying-layout, .security-layout { gap: 40px; }
    .pilot-panel { padding: 32px; gap: 32px; }
  }
  @media (max-width: 700px) {
    .wrap { padding-inline: 22px; }
    .page-header { gap: 12px; }
    .brand { font-size: 15px; }
    nav { gap: 14px; }
    nav > a:first-child { display: none; }
    .hero { grid-template-columns: 1fr; padding-block: 40px 56px; gap: 34px; }
    .hero-note .eyebrow { font-size: 11px; }
    .lead { font-size: 17px; }
    .section { padding-block: 56px; }
    .export-flow { grid-template-columns: 1fr; padding: 20px; }
    .flow-arrow { flex-direction: row; justify-content: center; padding-block: 6px; gap: 16px; }
    .flow-arrow :global(svg) { transform: rotate(90deg); }
    figcaption { padding-inline: 20px; }
    .ai-grid, .security-layout, .feature-grid, .buying-layout, .pilot-panel { grid-template-columns: 1fr; }
    .ai-grid { gap: 34px; }
    .security-layout { gap: 24px; }
    .feature-grid { gap: 28px; }
    .pilot-panel { padding: 26px; gap: 36px; }
    .faq { padding-bottom: 64px; }
  }
</style>
