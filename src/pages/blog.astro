---
import BlogLayout from "../layouts/BlogLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import CategoryIcon from "../components/blog/CategoryIcon.astro";
import { ArrowRight } from "lucide-react";
import { getBlogPosts, groupBlogPosts } from "../lib/blog";
import { blogCategoryPath } from "../lib/blog-categories";

const posts = await getBlogPosts();
const groups = groupBlogPosts(posts);
const featured = posts[0];
---

<BlogLayout groups={groups}>
  {featured && (
    <section aria-labelledby="latest-heading" class="mb-16 sm:mb-20">
      <p id="latest-heading" class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Latest article</p>
      <PostCard post={featured} featured />
    </section>
  )}

  <div class="space-y-14 sm:space-y-18">
    {groups.map(({ category, posts: categoryPosts }) => (
      <section aria-labelledby={`topic-${category.id}`}>
        <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <div class="mb-3 flex items-center gap-3">
              <CategoryIcon category={category.id} />
              <h2 id={`topic-${category.id}`} class="text-2xl font-semibold tracking-tight sm:text-3xl">
                <a href={blogCategoryPath(category.id)} class="rounded-sm transition-colors hover:text-brand-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-text">{category.label}</a>
              </h2>
            </div>
            <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">{category.description}</p>
          </div>
          <a href={blogCategoryPath(category.id)} aria-label={`View all ${categoryPosts.length} articles in ${category.label}`} class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-medium text-brand-text hover:underline">
            View all <span class="text-muted-foreground">({categoryPosts.length})</span>
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
        </header>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {categoryPosts.slice(0, 3).map((post) => <PostCard post={post} />)}
        </div>
      </section>
    ))}
  </div>

  {posts.length === 0 && <p class="py-16 text-center text-muted-foreground">New articles are on their way. Explore our <a href="/docs/" class="text-brand-text underline">documentation</a> in the meantime.</p>}
</BlogLayout>
