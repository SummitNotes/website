---
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Prose from '../../components/article/Prose.astro';
import LinkCard from '../../components/article/LinkCard.astro';
import { Calendar, User } from 'lucide-react';
import { blogPostingSchema } from '../../lib/schema';
import { getBlogPosts } from '../../lib/blog';
import { getBlogCategory, blogCategoryPath } from '../../lib/blog-categories';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const category = getBlogCategory(post.data.category);
// Keep reading within the current topic.
const sortedPosts = (await getBlogPosts()).filter((p) => p.data.category === category.id);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const postSchema = blogPostingSchema({
  path: `/blog/${post.slug}`,
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image,
  author: post.data.author,
  datePublished: post.data.publishedDate,
  keywords: post.data.tags,
});
postSchema.articleSection = category.label;
---

<ArticleLayout
  title={`${post.data.title} - Summit AI Notes Blog`}
  description={post.data.description}
  breadcrumb={[{ name: "Blog", path: "/blog/" }, { name: category.label, path: blogCategoryPath(category.id) }, { name: post.data.title }]}
  schema={postSchema}
  heading={post.data.title}
  lead={post.data.description}
>
  {post.data.image && (
    <div slot="before-card" class="rounded-xl overflow-hidden mb-8 shadow-lg">
      <img
        src={post.data.image}
        alt={post.data.imageAlt || post.data.title}
        class="w-full h-full object-cover"
      />
    </div>
  )}

  <div slot="meta" class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-4">
    <a href={blogCategoryPath(category.id)} class="rounded-full bg-brand-soft px-3 py-1.5 font-medium text-brand-strong transition-colors hover:bg-brand-wash">{category.label}</a>
    <span class="flex items-center gap-1">
      <Calendar className="w-4 h-4" />
      <time datetime={post.data.publishedDate.toISOString()}>{post.data.publishedDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })}</time>
    </span>
    <span class="flex items-center gap-1">
      <User className="w-4 h-4" />
      {post.data.author}
    </span>
  </div>

  <Prose>
    <Content />
  </Prose>

  <Fragment slot="after-card">
    {prevPost ? (
      <LinkCard href={`/blog/${prevPost.slug}`} kicker="Previous post" title={prevPost.data.title} />
    ) : <div />}
    {nextPost ? (
      <LinkCard href={`/blog/${nextPost.slug}`} kicker="Next post" title={nextPost.data.title} align="right" />
    ) : <div />}
  </Fragment>

  <div slot="card-end" class="flex flex-wrap items-center justify-between gap-4 text-sm">
    <span class="text-muted-foreground">More in {category.label}</span>
    <a href={blogCategoryPath(category.id)} class="font-medium text-brand-text hover:underline">View all articles in this topic &rarr;</a>
  </div>
</ArticleLayout>
