---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Prose from '../../components/article/Prose.astro';
import LinkCard from '../../components/article/LinkCard.astro';
import { Calendar, User } from 'lucide-react';
import { blogPostingSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Get all posts for navigation
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const postSchema = blogPostingSchema({
  path: `/blog/${post.slug}`,
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image,
  author: post.data.author,
  datePublished: post.data.publishedDate,
  keywords: post.data.tags,
});
---

<ArticleLayout
  title={`${post.data.title} - Summit AI Notes Blog`}
  description={post.data.description}
  breadcrumb={[{ name: "Blog", path: "/blog" }, { name: post.data.title }]}
  schema={postSchema}
  heading={post.data.title}
  lead={post.data.description}
>
  {post.data.image && (
    <div slot="before-card" class="rounded-xl overflow-hidden mb-8 shadow-lg">
      <img
        src={post.data.image}
        alt={post.data.imageAlt || post.data.title}
        class="w-full h-full object-cover"
      />
    </div>
  )}

  <div slot="meta" class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-4">
    <span class="flex items-center gap-1">
      <Calendar className="w-4 h-4" />
      {post.data.publishedDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      })}
    </span>
    <span class="flex items-center gap-1">
      <User className="w-4 h-4" />
      {post.data.author}
    </span>
  </div>

  {post.data.tags && (
    <div slot="header-end" class="flex flex-wrap gap-2 mt-6">
      {post.data.tags.map((tag: string) => (
        <span class="px-3 py-1 bg-brand-soft text-brand-strong rounded-full text-sm">
          {tag}
        </span>
      ))}
    </div>
  )}

  <Prose>
    <Content />
  </Prose>

  <Fragment slot="after-card">
    {prevPost ? (
      <LinkCard href={`/blog/${prevPost.slug}`} kicker="Previous post" title={prevPost.data.title} />
    ) : <div />}
    {nextPost ? (
      <LinkCard href={`/blog/${nextPost.slug}`} kicker="Next post" title={nextPost.data.title} align="right" />
    ) : <div />}
  </Fragment>
</ArticleLayout>
