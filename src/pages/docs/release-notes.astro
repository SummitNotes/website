---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import DocsNav from "../../components/article/DocsNav.astro";
import { Card } from "../../components/ui/card";
import { ChevronRight, Calendar, Tag } from "lucide-react";
import { releases } from "../../lib/releases";

function formatDate(date?: string) {
  if (!date) return null;
  const parsed = new Date(date);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<ArticleLayout
  title="Release Notes - Summit AI Notes Documentation"
  description="What's new in every version of Summit AI Notes."
  breadcrumb={[
    { name: "Documentation", path: "/docs" },
    { name: "Release Notes" },
  ]}
  heading="Release Notes"
  lead="See what's new in every version of Summit AI Notes — new features, improvements, and bug fixes."
>
  <DocsNav slot="sidebar" current="release-notes" />

  <ul class="space-y-4">
    {releases.map((release) => (
      <li>
        <a href={release.url} class="group block">
          <Card className="p-5 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-10 h-10 rounded-lg bg-brand-wash text-brand">
                  <Tag className="w-5 h-5" />
                </span>
                <div>
                  <div class="font-semibold text-foreground group-hover:text-brand-text transition-colors">
                    {release.title}
                  </div>
                  {release.date && (
                    <div class="flex items-center gap-1.5 text-sm text-muted-foreground mt-0.5">
                      <Calendar className="w-3.5 h-3.5" />
                      {formatDate(release.date)}
                    </div>
                  )}
                </div>
              </div>
              <ChevronRight className="w-5 h-5 text-muted-foreground group-hover:text-brand-text transition-colors" />
            </div>
          </Card>
        </a>
      </li>
    ))}
  </ul>
</ArticleLayout>
