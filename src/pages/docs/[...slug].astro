---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Prose from '../../components/article/Prose.astro';
import LinkCard from '../../components/article/LinkCard.astro';
import DocsNav from '../../components/article/DocsNav.astro';
import { techArticleSchema } from '../../lib/schema';
import { categoryLabel, getDocsByCategory } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await doc.render();

// Previous and next pages within the doc's own category
const category = doc.data.category || 'guides';
const categoryDocs = (await getDocsByCategory()).find((c) => c.category === category)?.docs ?? [];
const currentIndex = categoryDocs.findIndex((d) => d.slug === doc.slug);
const prevDoc = currentIndex > 0 ? categoryDocs[currentIndex - 1] : null;
const nextDoc = currentIndex < categoryDocs.length - 1 ? categoryDocs[currentIndex + 1] : null;

const docSchema = techArticleSchema({
  path: `/docs/${doc.slug}`,
  headline: doc.data.title,
  description: doc.data.description,
  dateModified: doc.data.lastUpdated,
});

// Categories are labels in the visible trail, not pages, so they stay out of the
// structured breadcrumb — every entry below Home links somewhere real.
const breadcrumb = [
  { name: 'Documentation', path: '/docs' },
  { name: doc.data.title },
];
const trail = doc.data.category
  ? [breadcrumb[0], { name: categoryLabel(doc.data.category) }, breadcrumb[1]]
  : breadcrumb;
---

<ArticleLayout
  title={`${doc.data.title} - Summit AI Notes Documentation`}
  description={doc.data.description}
  breadcrumb={breadcrumb}
  trail={trail}
  schema={docSchema}
  heading={doc.data.title}
  lead={doc.data.description}
>
  <DocsNav slot="sidebar" current={doc.slug} />

  {doc.data.lastUpdated && (
    <p slot="header-end" class="text-sm text-muted-foreground mt-4">
      Last updated: {doc.data.lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
  )}

  <Prose>
    <Content />
  </Prose>

  {(prevDoc || nextDoc) && (
    <Fragment slot="after-card">
      {prevDoc ? (
        <LinkCard href={`/docs/${prevDoc.slug}`} kicker="Previous" title={prevDoc.data.title} />
      ) : <div />}
      {nextDoc ? (
        <LinkCard href={`/docs/${nextDoc.slug}`} kicker="Next" title={nextDoc.data.title} align="right" />
      ) : <div />}
    </Fragment>
  )}
</ArticleLayout>
