---
import { ChevronRight, Home } from "lucide-react";
import type { Crumb } from "../../lib/schema";

export interface Props {
  /** The trail below Home, ending with the current page (no `path`). */
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
  <a href="/" class="hover:text-foreground transition-colors flex items-center gap-1">
    <Home className="w-4 h-4" />
    Home
  </a>
  {crumbs.map((crumb, i) => (
    <>
      <ChevronRight className="w-4 h-4 shrink-0" />
      {i === crumbs.length - 1 ? (
        <span class="text-foreground font-medium truncate max-w-[200px] sm:max-w-sm">{crumb.name}</span>
      ) : crumb.path ? (
        <a href={crumb.path} class="hover:text-foreground transition-colors">{crumb.name}</a>
      ) : (
        <span>{crumb.name}</span>
      )}
    </>
  ))}
</nav>
