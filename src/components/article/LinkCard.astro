---
import { Card } from "../ui/card";

export interface Props {
  href: string;
  /** Small line above the title naming the relation, e.g. "Previous post". */
  kicker: string;
  title: string;
  align?: "left" | "right";
}

const { href, kicker, title, align = "left" } = Astro.props;
---

<a href={href} class="group">
  <Card className={`p-4 gap-0 hover:shadow-lg transition-shadow h-full ${align === "right" ? "text-right" : ""}`}>
    <div class="text-sm text-muted-foreground mb-1">{kicker}</div>
    <div class="font-semibold text-foreground group-hover:text-brand-text transition-colors">{title}</div>
  </Card>
</a>
