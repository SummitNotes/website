---
export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="not-prose my-6 border-l-4 border-brand bg-brand-wash rounded-r-lg px-6 py-4">
  {title && <p class="font-semibold text-foreground mb-1">{title}</p>}
  <div class="text-foreground leading-relaxed [&_a]:text-brand-text [&_a:hover]:underline">
    <slot />
  </div>
</aside>
