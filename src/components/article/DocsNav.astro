---
import { Card } from "../ui/card";
import { Book } from "lucide-react";
import { getDocsByCategory } from "../../lib/docs";

export interface Props {
  /** Slug of the current doc, or "release-notes" for the release pages. */
  current?: string;
}

const { current } = Astro.props;
const categories = await getDocsByCategory();

const row = "block px-3 py-2 rounded-md text-sm transition-colors";
const idle = `${row} text-muted-foreground hover:text-foreground hover:bg-muted/50`;
const active = `${row} bg-brand-wash text-brand-text font-medium`;
---

<Card className="p-6 gap-0">
  <div class="flex items-center gap-2 mb-6">
    <Book className="w-5 h-5 text-brand" />
    <a href="/docs" class="text-lg font-semibold text-foreground hover:text-brand-text transition-colors">Documentation</a>
  </div>

  <nav aria-label="Documentation" class="space-y-6">
    {categories.map(({ label, docs }) => (
      <div>
        <h3 class="text-sm font-semibold text-foreground mb-2 uppercase tracking-wide">{label}</h3>
        <ul class="space-y-1">
          {docs.map((doc) => (
            <li>
              <a
                href={`/docs/${doc.slug}`}
                class={doc.slug === current ? active : idle}
                aria-current={doc.slug === current ? "page" : undefined}
              >
                {doc.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div>
      <h3 class="text-sm font-semibold text-foreground mb-2 uppercase tracking-wide">Release Notes</h3>
      <ul class="space-y-1">
        <li>
          <a
            href="/docs/release-notes"
            class={current === "release-notes" ? active : idle}
            aria-current={current === "release-notes" ? "page" : undefined}
          >
            All Releases
          </a>
        </li>
      </ul>
    </div>
  </nav>
</Card>
