---
export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="not-prose my-6 border-l-4 border-purple-600 bg-purple-50 dark:bg-purple-600/10 rounded-r-lg px-6 py-4">
  {title && <p class="font-semibold text-foreground mb-1">{title}</p>}
  <div class="text-muted-foreground leading-relaxed [&_a]:text-purple-600 [&_a:hover]:underline">
    <slot />
  </div>
</aside>
