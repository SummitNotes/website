---
export interface Props {
  /** `body` may contain inline HTML such as links. */
  steps: { title: string; body: string }[];
}

const { steps } = Astro.props;
---

<ol class="not-prose my-6 space-y-5">
  {steps.map((step, i) => (
    <li class="flex gap-4">
      <span class="w-7 h-7 shrink-0 rounded-full bg-purple-100 text-purple-700 dark:bg-purple-600/20 dark:text-purple-300 text-sm font-semibold flex items-center justify-center">
        {i + 1}
      </span>
      <div>
        <h3 class="font-semibold text-foreground mb-1">{step.title}</h3>
        <p class="text-muted-foreground leading-relaxed [&_a]:text-purple-600 [&_a:hover]:underline" set:html={step.body} />
      </div>
    </li>
  ))}
</ol>
