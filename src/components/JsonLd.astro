---
import type { SchemaNode } from "../lib/schema";

interface Props {
  /** Nodes to emit as a single connected `@graph`. */
  nodes: SchemaNode[];
}

const { nodes } = Astro.props;

// The graph carries one shared @context, so drop any per-node copies.
const graph = nodes.map(({ "@context": _context, ...node }) => node);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
