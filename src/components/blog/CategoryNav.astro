---
import type { BlogGroup } from "../../lib/blog";
import { blogCategoryPath, type BlogCategoryId } from "../../lib/blog-categories";

interface Props {
  groups: BlogGroup[];
  activeCategory?: BlogCategoryId;
}

const { groups, activeCategory } = Astro.props;
const total = groups.reduce((count, group) => count + group.posts.length, 0);
const links = [
  { href: "/blog/", label: "All topics", count: total, current: !activeCategory },
  ...groups.map(({ category, posts }) => ({
    href: blogCategoryPath(category.id),
    label: category.label,
    count: posts.length,
    current: activeCategory === category.id,
  })),
];
---

<nav aria-label="Blog categories" class="border-y border-border py-5 mb-10 sm:mb-12">
  <ul class="flex flex-wrap gap-2">
    {links.map(({ href, label, count, current }) => (
      <li>
        <a
          href={href}
          aria-current={current ? "page" : undefined}
          class:list={[
            "inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 py-2 text-[13px] font-medium transition-colors sm:text-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-text",
            current
              ? "bg-foreground text-background"
              : "bg-muted/60 text-muted-foreground hover:bg-brand-soft hover:text-brand-strong",
          ]}
        >
          {label}
          <span class:list={["text-xs tabular-nums", current ? "opacity-70" : "text-muted-foreground"]}>{count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
